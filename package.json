{
  "name": "cl25m-placement-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:offline": "vite build --mode offline",
    "build:web": "vite build --mode web",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "VITE_SUPABASE_URL=http://127.0.0.1:54321 VITE_SUPABASE_ANON_KEY=sb_publishable_e2e vite build --mode web --outDir .e2e-web --emptyOutDir && vite-node tests/e2e/run.ts -- .e2e-web",
    "bundle:functions": "node scripts/bundle-functions.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "exceljs": "^4.4.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^2.1.9"
  },
  "description": "Real-time placement application tracking and coordination platform with privacy-preserving analytics, assessment monitoring and role-based access.",
  "license": "MIT",
  "author": "Arya Murukesan"
}
